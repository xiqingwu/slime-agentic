ninja_required_version = 1.3
cxx = /root/autodl-tmp/micromamba/envs/slime/bin/x86_64-conda-linux-gnu-c++
nvcc = /root/autodl-tmp/micromamba/envs/slime/bin/nvcc

cflags = -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /root/autodl-tmp/micromamba/envs/slime/include -I/root/autodl-tmp/micromamba/envs/slime/targets/x86_64-linux/include -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /root/autodl-tmp/micromamba/envs/slime/include -I/root/autodl-tmp/micromamba/envs/slime/targets/x86_64-linux/include -fPIC -I/root/autodl-tmp/micromamba/envs/slime/lib/python3.12/site-packages/torch/include -I/root/autodl-tmp/micromamba/envs/slime/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/root/autodl-tmp/micromamba/envs/slime/include -I/root/autodl-tmp/micromamba/envs/slime/include/python3.12 -c
post_cflags = -O3 -std=c++17 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=fake_int4_quant_cuda
cuda_cflags = -I/root/autodl-tmp/micromamba/envs/slime/lib/python3.12/site-packages/torch/include -I/root/autodl-tmp/micromamba/envs/slime/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/root/autodl-tmp/micromamba/envs/slime/include -I/root/autodl-tmp/micromamba/envs/slime/include/python3.12 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -std=c++17 --expt-relaxed-constexpr -Xcompiler -fPIC -gencode=arch=compute_89,code=sm_89 -gencode=arch=compute_90a,code=sm_90a -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=fake_int4_quant_cuda -ccbin /root/autodl-tmp/micromamba/envs/slime/bin/x86_64-conda-linux-gnu-cc
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







